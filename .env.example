CORE_PORT=8000
ORCHESTRATOR_PORT=8001
ORCHESTRATOR_URL=http://orchestrator:8001

DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/chatdb
REDIS_URL=redis://redis:6379/0

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://ollama:11434
PROVIDER_TIMEOUT=30

# New chats default to the free router. The API exposes every OpenRouter model,
# so users with credits can select paid models. OpenRouter requires an API key.
DEFAULT_OPENROUTER_MODEL=openrouter/free
DEFAULT_FALLBACK_MODEL=qwen2.5:3b

WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=securepassword123
WEBUI_SECRET_KEY=my_secure_random_secret_string_123
OPENAI_API_BASE_URL=http://core:8000/v1
OPENAI_API_KEY=dummy_key_not_used
